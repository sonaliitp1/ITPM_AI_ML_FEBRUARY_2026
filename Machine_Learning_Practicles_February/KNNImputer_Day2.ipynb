   "source": [
    "import numpy as np \n",
    "from sklearn.impute import KNNImputer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "e1b7877a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[[ 2.  4. nan]\n",
      " [ 5.  1.  6.]\n",
      " [nan  5.  7.]\n",
      " [ 9.  8.  9.]]\n"
     ]
    }
   ],
   "source": [
    "data = np.array([\n",
    "    [2,4,np.nan],\n",
    "    [5,1,6],\n",
    "    [np.nan,5,7],\n",
    "    [9,8,9]\n",
    "])\n",
    "print(data)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "4c956dc9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[[2.  4.  6.5]\n",
      " [5.  1.  6. ]\n",
      " [5.5 5.  7. ]\n",
      " [9.  8.  9. ]]\n"
     ]
    }
   ],
   "source": [
    "knn_imputer = KNNImputer(n_neighbors=2)\n",
    "new_data = knn_imputer.fit_transform(data)\n",
    "print(new_data)"
   ]
  },
