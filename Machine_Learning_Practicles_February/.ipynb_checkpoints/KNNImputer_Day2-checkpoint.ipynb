   "source": [
    "import numpy as np \n",
    "from sklearn.impute import KNNImputer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e1b7877a",
   "metadata": {},
   "outputs": [],
   "source": [
    "data = np.array([\n",
    "    [2,4,np.nan],\n",
    "    [5,1,6],\n",
    "    [np.nan,5,7],\n",
    "    [9,8,9]\n",
    "])\n",
    "print(data)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4c956dc9",
   "metadata": {},
   "outputs": [],
   "source": [
    "knn_imputer = KNNImputer(n_neighbors=2)\n",
    "new_data = knn_imputer.fit_transform(data)\n",
    "print(new_data)"
   ]
  },
